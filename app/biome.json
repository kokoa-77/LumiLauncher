{
  "files": {
    "includes": ["src/**", "*.ts", "*.json", "!src/lib/bindings.ts", "!src-tauri"]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 100
  },
  "javascript": {
    "formatter": { "quoteStyle": "double" }
  },
  "css": {
    "parser": { "tailwindDirectives": true }
  },
  "linter": {
    "enabled": true,
    "rules": { "preset": "none" }
  },
  "assist": {
    "actions": { "source": { "organizeImports": "on" } }
  }
}
