<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1080" Height="660" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="14" Foreground="#EEF5FF" Background="#101A30" UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="TextMuted" Color="#B7C8E0"/>
    <BitmapCache x:Key="FolderCache"/>
    <Style TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="ButtonBase" TargetType="Button">
      <Setter Property="Background" Value="#213453"/>
      <Setter Property="Foreground" Value="#EEF5FF"/>
      <Setter Property="Padding" Value="18,10"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="BorderBrush" Value="#486A92"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="20" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value=".82"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value=".68"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#FFFFFF"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value=".45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource ButtonBase}"/>
    <Style x:Key="WindowButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
      <Setter Property="Width" Value="44"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#476387AC"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="WindowClose" TargetType="Button" BasedOn="{StaticResource WindowButton}">
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#C2585A"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="BrowseButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Padding" Value="8,7"/>
      <Setter Property="Foreground" Value="#B9CDE5"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#34516B90"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
      <Setter Property="Background" Value="#A4CDFF"/>
      <Setter Property="Foreground" Value="#0B1B32"/>
      <Setter Property="BorderBrush" Value="#D0E7FF"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="MinWidth" Value="124"/>
    </Style>
    <Style x:Key="DangerPrimary" TargetType="Button" BasedOn="{StaticResource Primary}">
      <Setter Property="Background" Value="#F2A49F"/>
      <Setter Property="Foreground" Value="#371821"/>
      <Setter Property="BorderBrush" Value="#FFD0C9"/>
    </Style>
    <Style x:Key="SetupProgress" TargetType="ProgressBar">
      <Setter Property="Height" Value="8"/>
      <Setter Property="Background" Value="#388BABD3"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid ClipToBounds="True" Background="Transparent">
              <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
              <Border x:Name="BarFill" CornerRadius="4" ClipToBounds="True">
                <Border.RenderTransform><ScaleTransform ScaleX="0"/></Border.RenderTransform>
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Offset="0" Color="#588CD9"/>
                    <GradientStop Offset=".74" Color="#8BB9FA"/>
                    <GradientStop Offset="1" Color="#BDDDFF"/>
                  </LinearGradientBrush>
                </Border.Background>
                <Rectangle x:Name="BarGleam" Width="105" Opacity="0" HorizontalAlignment="Left" IsHitTestVisible="False">
                  <Rectangle.RenderTransform><TranslateTransform X="-105"/></Rectangle.RenderTransform>
                  <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                      <GradientStop Offset="0" Color="#00FFFFFF"/>
                      <GradientStop Offset=".5" Color="#6BFFFFFF"/>
                      <GradientStop Offset="1" Color="#00FFFFFF"/>
                    </LinearGradientBrush>
                  </Rectangle.Fill>
                </Rectangle>
              </Border>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="1,4"/>
      <Setter Property="Foreground" Value="#F3F8FF"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="CaretBrush" Value="#C9E2FF"/>
      <Setter Property="MinHeight" Value="34"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#DCEAFF"/>
      <Setter Property="Margin" Value="0,8,0,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="Indicator" Width="16" Height="16" CornerRadius="5"
                      BorderThickness="1" BorderBrush="#8298BE" Background="#650E1A30">
                <Path x:Name="Tick" Data="M 0,4 L 3,7 L 9,0" Stroke="#0D1D33"
                      StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Indicator" Property="Background" Value="#A4CDFF"/>
                <Setter TargetName="Indicator" Property="BorderBrush" Value="#A4CDFF"/>
                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Indicator" Property="BorderBrush" Value="#FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border>
    <Grid>
      <Grid IsHitTestVisible="False" CacheMode="BitmapCache">
        <Image Name="NightScene" Stretch="UniformToFill"
               RenderOptions.BitmapScalingMode="HighQuality"/>
        <Rectangle>
          <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
              <GradientStop Offset="0" Color="#1D0A1326"/>
              <GradientStop Offset=".5" Color="#3210192D"/>
              <GradientStop Offset=".8" Color="#4A0A1227"/>
              <GradientStop Offset="1" Color="#9B091327"/>
            </LinearGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
      </Grid>

      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="53"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="71"/>
        </Grid.RowDefinitions>

        <Border Name="TitleBar" Background="Transparent" BorderThickness="0,0,0,1">
          <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <GradientStop Offset="0" Color="#005D82B0"/>
              <GradientStop Offset=".35" Color="#227CA3D5"/>
              <GradientStop Offset=".65" Color="#227CA3D5"/>
              <GradientStop Offset="1" Color="#005D82B0"/>
            </LinearGradientBrush>
          </Border.BorderBrush>
          <Grid Margin="23,0,8,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Image Name="BrandIcon" Width="22" Height="22" Margin="0,0,10,0"/>
              <TextBlock Text="Lumi" FontSize="16" FontWeight="SemiBold"/>
            </StackPanel>
            <TextBlock Name="PageLabel" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#BDCCE3">
              <TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform>
            </TextBlock>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <Button Name="MinimizeButton" Style="{StaticResource WindowButton}">
                <Viewbox Width="16" Height="16">
                  <Path Data="M 1,7 L 15,7" Stroke="#D4E1F2" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Viewbox>
              </Button>
              <Button Name="CloseButton" Style="{StaticResource WindowClose}">
                <Viewbox Width="14" Height="14">
                  <Path Data="M 2,2 L 12,12 M 12,2 L 2,12" Stroke="#D4E1F2" StrokeThickness="1.65" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Viewbox>
              </Button>
            </StackPanel>
          </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="28,0">
          <StackPanel Name="WelcomeHero" Width="880" HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsHitTestVisible="False" Visibility="Hidden" SnapsToDevicePixels="True"
                      TextOptions.TextFormattingMode="Display">
            <StackPanel.RenderTransform><TranslateTransform/></StackPanel.RenderTransform>
            <TextBlock Name="WelcomeHeading" FontWeight="SemiBold" LineHeight="99"
                       TextAlignment="Center" LineStackingStrategy="BlockLineHeight"/>
            <TextBlock Name="WelcomeLead" FontSize="18" Foreground="#DFE9F9" Margin="0,9,0,0" LineHeight="23"
                       TextAlignment="Center" LineStackingStrategy="BlockLineHeight"/>
          </StackPanel>
          <StackPanel Name="PageBody" Width="620" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Name="Hero" CacheMode="BitmapCache">
              <StackPanel.RenderTransform><TranslateTransform/></StackPanel.RenderTransform>
              <TextBlock Name="Heading" FontSize="36" FontWeight="SemiBold" LineHeight="46" LineStackingStrategy="BlockLineHeight"/>
              <TextBlock Name="Lead" FontSize="15" Foreground="#DFE9F9" Margin="0,9,0,0" LineHeight="23" LineStackingStrategy="BlockLineHeight"/>
            </StackPanel>
            <ScrollViewer Name="Details" Margin="0,24,0,0" MaxHeight="366"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="Collapsed">
              <ScrollViewer.RenderTransform><TranslateTransform/></ScrollViewer.RenderTransform>
              <StackPanel>
              <StackPanel Name="Options">
                <Label Name="ProgramLabel" Padding="0" Foreground="#F0F6FF" FontWeight="SemiBold" Target="{Binding ElementName=ProgramPath}"/>
                <Border BorderBrush="#407494BD" BorderThickness="0,0,0,1" Margin="0,3,0,20">
                  <DockPanel>
                    <Button Name="ProgramBrowse" DockPanel.Dock="Right" Style="{StaticResource BrowseButton}">
                      <StackPanel Orientation="Horizontal">
                        <Viewbox Width="15" Height="15" Margin="0,0,7,0">
                          <Path Data="M 3,5 L 9,5 L 11,7 L 20,7 L 20,17 L 3,17 Z"
                                Stroke="#B9CDE5" StrokeThickness="1.5" StrokeLineJoin="Round"/>
                        </Viewbox>
                        <TextBlock Name="ProgramBrowseText"/>
                      </StackPanel>
                    </Button>
                    <TextBox Name="ProgramPath"/>
                  </DockPanel>
                </Border>
                <Label Name="GameLabel" Padding="0" Foreground="#F0F6FF" FontWeight="SemiBold" Target="{Binding ElementName=GamePath}"/>
                <Border BorderBrush="#407494BD" BorderThickness="0,0,0,1" Margin="0,3,0,9">
                  <DockPanel>
                    <Button Name="GameBrowse" DockPanel.Dock="Right" Style="{StaticResource BrowseButton}">
                      <StackPanel Orientation="Horizontal">
                        <Viewbox Width="15" Height="15" Margin="0,0,7,0">
                          <Path Data="M 3,5 L 9,5 L 11,7 L 20,7 L 20,17 L 3,17 Z"
                                Stroke="#B9CDE5" StrokeThickness="1.5" StrokeLineJoin="Round"/>
                        </Viewbox>
                        <TextBlock Name="GameBrowseText"/>
                      </StackPanel>
                    </Button>
                    <TextBox Name="GamePath"/>
                  </DockPanel>
                </Border>
                <TextBlock Name="DiskNote" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                <CheckBox Name="DesktopChoice" IsChecked="True"/>
                <CheckBox Name="PackChoice" IsChecked="True"/>
                <CheckBox Name="LaunchChoice" IsChecked="True"/>
                <TextBlock Name="PathError" Foreground="#FFD0C2" Margin="0,11,0,0" Visibility="Collapsed"/>
              </StackPanel>
              <StackPanel Name="Progress">
                <TextBlock Name="ProgressText" FontSize="17" FontWeight="SemiBold">
                  <TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform>
                </TextBlock>
                <ProgressBar Name="ProgressBar" Style="{StaticResource SetupProgress}" Margin="0,16,0,12"/>
                <TextBlock Name="ProgressHint" Style="{StaticResource Caption}" Margin="0,0,0,11"/>
                <TextBlock Name="ProgressInstallPath" Style="{StaticResource Caption}"/>
                <TextBlock Name="ProgressGamePath" Style="{StaticResource Caption}" Margin="0,7,0,0"/>
              </StackPanel>
              <StackPanel Name="Removal">
                <TextBlock Name="RemovalLabel" Foreground="#F0F6FF" FontWeight="SemiBold"/>
                <Border BorderBrush="#407494BD" BorderThickness="0,0,0,1" Margin="0,3,0,12">
                  <TextBox Name="RemovalPath" IsReadOnly="True"/>
                </Border>
                <CheckBox Name="CleanChoice" IsChecked="False"/>
                <TextBlock Name="RemovalHint" Style="{StaticResource Caption}" Margin="0,10,0,0"/>
              </StackPanel>
              <StackPanel Name="Summary">
                <TextBlock Name="SummaryTitle" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock Name="SummaryText" Style="{StaticResource Caption}" Margin="0,9,0,0"/>
              </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </StackPanel>
        </Grid>

        <Border Grid.Row="2">
          <DockPanel Name="Actions" Margin="30,0" LastChildFill="False">
            <DockPanel.RenderTransform><TranslateTransform/></DockPanel.RenderTransform>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Name="BackButton" MinWidth="78" Margin="0,0,10,0" Background="Transparent" BorderBrush="Transparent">
                <Button.RenderTransform><TranslateTransform/></Button.RenderTransform>
              </Button>
              <Button Name="NextButton" Style="{StaticResource Primary}" IsDefault="True">
                <TextBlock Name="NextText" TextWrapping="NoWrap">
                  <TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform>
                </TextBlock>
              </Button>
            </StackPanel>
            <TextBlock Name="Footnote" VerticalAlignment="Center" Style="{StaticResource Caption}" DockPanel.Dock="Left">
              <TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform>
            </TextBlock>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
